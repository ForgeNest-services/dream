ENVIRO=prod

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-superuser-password
POSTGRES_DB=dream_app

# DATABASE_ADMIN_URL: real superuser connection — used ONLY at startup for
# schema migrations (create_all, ensure_*_schema) and to create/update the
# restricted role below. Never used for request traffic.
DATABASE_ADMIN_URL=postgresql://postgres:change-me-postgres-superuser-password@postgres:5432/dream_app

# DATABASE_APP_USER/PASSWORD: the restricted role the running app actually
# connects as (core/seed.py's ensure_app_role creates/updates it at every
# startup). UPDATE/DELETE revoked on transaction tables — IRD: Electronic
# Billing Procedure 2082, clause 6.3घ (issued transaction data can't be
# modified/removed from the back-end either, not just the front-end).
DATABASE_APP_USER=srota_app
DATABASE_APP_PASSWORD=change-me-app-role-password

# DATABASE_URL: what the app (and worker) actually connect as for every
# request — points at DATABASE_APP_USER above, NOT postgres.
DATABASE_URL=postgresql://srota_app:change-me-app-role-password@postgres:5432/dream_app

REDIS_PASSWORD=change-me-redis-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

JWT_SECRET=. . .
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

SUPERADMIN_EMAIL=admin@yourdomain.com
SUPERADMIN_PASSWORD=secure-password-here

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback


BREVO_API_KEY=. . .
BREVO_FROM_EMAIL=noreply@chaudharynishant.com.np
BREVO_FROM_NAME=Dream

NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_ENVIRO=dev
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

VITE_API_URL=http://localhost:8006/api

# Object storage (MinIO now, S3-API-compatible so switching to real AWS S3
# later is just changing these values — app code never changes).
MINIO_ROOT_USER=dreamstorage
MINIO_ROOT_PASSWORD=miniostoragepasshoyo
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=dreamstorage
S3_SECRET_KEY=miniostoragepasshoyo
S3_BUCKET=dream-uploads
S3_REGION=us-east-1

# Encrypts secrets at rest (e.g. tenant IRD CBMS Taxpayer Portal password).
